{
  "name": "@duelo/load-balancer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Balanceador de cargas del api: reparte por turnos entre varias copias y revisa su salud. Solo módulos de Node. Dueño: Felipe.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
