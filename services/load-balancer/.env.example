# Copiar a .env para desarrollo local. Render inyecta PORT en producción.
PORT=
# URLs de las copias del api separadas por coma, sin "/" final (en local, p. ej. dos api en 4000 y 4001).
LB_BACKENDS=
# Opcional: cada cuántos milisegundos se revisa /health de cada copia (por defecto 10000).
LB_HEALTH_INTERVAL_MS=
