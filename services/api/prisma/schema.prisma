// Esquema de PostgreSQL (sección 8 de CLAUDE.md).
// Solo guarda lo comercial y lo histórico: los números de balance viven en @duelo/game-rules.
// Identificadores en camelCase dentro de TypeScript y snake_case en la base (@map / @@map).
//
// Prisma 7: la URL de conexión no va aquí sino en prisma.config.ts, y el cliente se genera
// como código TypeScript dentro de src/ para compilarse junto al resto del servicio.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SpellKind {
  spell
  ultimate
}

enum EndReason {
  KO
  TIMEOUT
  DRAW
  ABANDON
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  username           String   @unique
  email              String   @unique
  passwordHash       String   @map("password_hash")
  // Nunca negativos: lo garantizan las restricciones CHECK de la migración inicial.
  rating             Int      @default(0)
  gold               Int      @default(0)
  wins               Int      @default(0)
  losses             Int      @default(0)
  draws              Int      @default(0)
  equippedUltimateId String   @default("meteor") @map("equipped_ultimate_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  equippedUltimate Spell           @relation("EquippedUltimate", fields: [equippedUltimateId], references: [id])
  spells           UserSpell[]
  grimoireSlots    GrimoireSlot[]
  matchesWon       Match[]         @relation("MatchWinner")
  matchPlayers     MatchPlayer[]

  // El ranking ordena por rating: el índice evita recorrer toda la tabla.
  @@index([rating(sort: Desc)])
  @@map("users")
}

model Spell {
  // id en inglés y kebab-case, igual que en el socket (lightning, silence-seal…).
  id                 String    @id
  name               String
  kind               SpellKind
  gestureDescription String    @map("gesture_description")
  price              Int       @default(0)
  isStarter          Boolean   @default(false) @map("is_starter")
  sortOrder          Int       @default(0) @map("sort_order")

  owners        UserSpell[]
  grimoireSlots GrimoireSlot[]
  equippedBy    User[]         @relation("EquippedUltimate")

  @@map("spells")
}

model UserSpell {
  userId     String   @map("user_id") @db.Uuid
  spellId    String   @map("spell_id")
  pricePaid  Int      @default(0) @map("price_paid")
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  spell Spell @relation(fields: [spellId], references: [id])

  // La PK compuesta impide comprar dos veces el mismo hechizo.
  @@id([userId, spellId])
  @@map("user_spells")
}

model GrimoireSlot {
  userId  String @map("user_id") @db.Uuid
  // 1–4 (CHECK en la migración). Slots 1 y 2 = Rayo y Escudo.
  slot    Int
  spellId String @map("spell_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  spell Spell @relation(fields: [spellId], references: [id])

  @@id([userId, slot])
  // Un mismo hechizo no puede ocupar dos espacios.
  @@unique([userId, spellId])
  @@map("grimoire_slots")
}

model Match {
  // Usa el mismo id que asignó el game-server, para casar Redis, logs y PostgreSQL.
  id         String    @id @db.Uuid
  endReason  EndReason @map("end_reason")
  // null en empate.
  winnerId   String?   @map("winner_id") @db.Uuid
  durationMs Int       @map("duration_ms")
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt    DateTime  @map("ended_at") @db.Timestamptz(3)

  winner  User?         @relation("MatchWinner", fields: [winnerId], references: [id])
  players MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  matchId      String @map("match_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  ratingBefore Int    @map("rating_before")
  ratingDelta  Int    @map("rating_delta")
  goldDelta    Int    @map("gold_delta")
  finalHp      Int    @map("final_hp")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
  // El historial se consulta por usuario.
  @@index([userId])
  @@map("match_players")
}
