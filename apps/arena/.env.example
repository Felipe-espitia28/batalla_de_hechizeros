# Valores en Bitwarden. Copiar a .env.local y rellenar.
# En local: el api en su puerto y el game-server (pnpm dev:game) en el suyo.
VITE_API_URL=
VITE_GAME_SERVER_URL=
# WebSocket del agente local en el PC del jugador (ws://127.0.0.1:<AGENT_PORT>/events, ver apps/local-agent).
VITE_LOCAL_AGENT_URL=
# Descarga del agente para jugadores: .../releases/latest/download/agente-local-windows.zip
VITE_LOCAL_AGENT_DOWNLOAD_URL=
