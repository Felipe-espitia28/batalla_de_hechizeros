# Copiar a .env y rellenar. No hay secretos: el agente solo escucha en 127.0.0.1.
# Puerto del agente; debe coincidir con VITE_LOCAL_AGENT_URL de la Arena.
AGENT_PORT=
# Orígenes de las páginas que cargan la Arena, separados por coma. Dentro del shell (Module Federation)
# el navegador manda el Origin del SHELL, no el de la Arena: incluye el shell (http://localhost:5173 y su
# URL de Vercel) y la Arena sola (http://localhost:5174 y su URL de Vercel). Sin el shell, el agente responde 403.
ALLOWED_ORIGINS=
# "false" para no abrir la ventana del detector al arrancar (pruebas). Por defecto se abre.
AGENT_OPEN_BROWSER=
