{
  "name": "@duelo/tienda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote Tienda: catálogo, compra, inventario y grimorio. Dueño: Angel.",
  "scripts": {
    "build:deps": "tsc -p ../../packages/contracts/tsconfig.json && tsc -p ../../packages/game-rules/tsconfig.json",
    "dev": "npm run build:deps && vite",
    "build": "npm run build:deps && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:deps && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@duelo/contracts": "workspace:*",
    "@duelo/game-rules": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@module-federation/vite": "1.22.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
